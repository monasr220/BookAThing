JWT_ACCESS_SECRET=your_access_secret_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRE=7d
MONGO_URI="mongodb://localhost:27017/booking"
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
NODE_ENV=development
PORT=5000
CLINET_URL="http://localhost:5173"
# In production, set CLIENT_URLS to a comma-separated list of allowed frontend origins,
# e.g. CLIENT_URLS=https://app.example.com,https://admin.example.com
# In development, common localhost ports (3000, 5173-5175) are already allowed automatically.

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

JWT_SECRET_KEY=your_secret_key_here


STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

