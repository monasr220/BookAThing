              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "if (pm.response.code < 300) {",
                  "    const body = pm.response.json();",
                  "    if (body.devOtp) pm.collectionVariables.set('lastOtp', body.devOtp);",
                  "}",
